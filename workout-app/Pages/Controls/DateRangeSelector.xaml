<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="workout_app.Pages.Controls.DateRangeSelector"
             x:DataType="DateRangeSelector">

    <Border HeightRequest="55" Padding="4" Shadow="{x:Null}">

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">

            <Button
                Grid.Column="0"
                Style="{StaticResource WaRangeButtonStyle}"
                Text="{Binding FirstRangeText}"
                Command="{Binding RangeSelectedCommand}"
                CommandParameter="{Binding FirstRangeValue}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding SelectedRange}" Value="{x:Static RangeType.Week}">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource wa-color-input}, Dark={StaticResource wa-dark-accent}}"/>
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource wa-color-button}, Dark={StaticResource wa-dark-background}}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button
                Grid.Column="1"
                Style="{StaticResource WaRangeButtonStyle}"
                Text="{Binding SecondRangeText}"
                Command="{Binding RangeSelectedCommand}"
                CommandParameter="{Binding SecondRangeValue}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding SelectedRange}" Value="{x:Static RangeType.Month}">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource wa-color-input}, Dark={StaticResource wa-dark-accent}}"/>
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource wa-color-button}, Dark={StaticResource wa-dark-background}}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button
                Grid.Column="2"
                Style="{StaticResource WaRangeButtonStyle}"
                Text="{Binding ThirdRangeText}"
                Command="{Binding RangeSelectedCommand}"
                CommandParameter="{Binding ThirdRangeValue}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding SelectedRange}" Value="{x:Static RangeType.Max}">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource wa-color-input}, Dark={StaticResource wa-dark-accent}}"/>
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource wa-color-button}, Dark={StaticResource wa-dark-background}}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

        </Grid>
    </Border>

</ContentView>
