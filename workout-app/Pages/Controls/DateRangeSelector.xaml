<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="workout_app.Pages.Controls.DateRangeSelector"
             x:DataType="DateRangeSelector">

    <!-- Selected range gets the input color; C# expressions (net11) replace the former value converter -->
    <Border HeightRequest="55">

        <Grid ColumnDefinitions="*,*,*">

            <Button
                Grid.Column="0"
                Style="{StaticResource WaRangeButtonStyle}"
                Text="{Binding FirstRangeText}"
                Command="{Binding RangeSelectedCommand}"
                CommandParameter="{Binding FirstRangeValue}"
                BackgroundColor="{.SelectedRange == RangeType.Week ? Color.FromArgb('#edf3fd') : Colors.White}" />

            <Button
                Grid.Column="1"
                Style="{StaticResource WaRangeButtonStyle}"
                Text="{Binding SecondRangeText}"
                Command="{Binding RangeSelectedCommand}"
                CommandParameter="{Binding SecondRangeValue}"
                BackgroundColor="{.SelectedRange == RangeType.Month ? Color.FromArgb('#edf3fd') : Colors.White}" />

            <Button
                Grid.Column="2"
                Style="{StaticResource WaRangeButtonStyle}"
                Text="{Binding ThirdRangeText}"
                Command="{Binding RangeSelectedCommand}"
                CommandParameter="{Binding ThirdRangeValue}"
                BackgroundColor="{.SelectedRange == RangeType.Max ? Color.FromArgb('#edf3fd') : Colors.White}" />

        </Grid>
    </Border>

</ContentView>
