<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="workout_app.Pages.Controls.DateRangeSelector"
             x:DataType="DateRangeSelector">

    <!-- TODO: remove as soon as possible in net10 and 11 -->
    <ContentView.Resources>
        <ResourceDictionary>
            <RadioButtonRangeToColorConverter x:Key="RangeToColorConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Border HeightRequest="55">

        <Grid ColumnDefinitions="*,*,*">

            <Button
                Grid.Column="0"
                Style="{StaticResource WaRangeButtonStyle}"
                Text="{Binding FirstRangeText}"
                Command="{Binding RangeSelectedCommand}"
                CommandParameter="{Binding FirstRangeValue}"
                BackgroundColor="{Binding SelectedRange, Converter={StaticResource RangeToColorConverter}, ConverterParameter=Week}" />

            <Button
                Grid.Column="1"
                Style="{StaticResource WaRangeButtonStyle}"
                Text="{Binding SecondRangeText}"
                Command="{Binding RangeSelectedCommand}"
                CommandParameter="{Binding SecondRangeValue}"
                BackgroundColor="{Binding SelectedRange, Converter={StaticResource RangeToColorConverter}, ConverterParameter=Month}" />

            <Button
                Grid.Column="2"
                Style="{StaticResource WaRangeButtonStyle}"
                Text="{Binding ThirdRangeText}"
                Command="{Binding RangeSelectedCommand}"
                CommandParameter="{Binding ThirdRangeValue}"
                BackgroundColor="{Binding SelectedRange, Converter={StaticResource RangeToColorConverter}, ConverterParameter=Max}" />

        </Grid>
    </Border>

</ContentView>
