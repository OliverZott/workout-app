<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="workout_app.Pages.Controls.DataSummary"
             x:Name="DataSummaryControl">

    <Grid ColumnDefinitions="*, *"
          ColumnSpacing="20">

        <Border>
            <VerticalStackLayout VerticalOptions="Center" Margin="10">
                <Label Text="{x:Static AppResources.average}" Style="{StaticResource WaUnitLabelStyle}" HorizontalOptions="Center"/>
                <Label Text="{Binding Source={x:Reference DataSummaryControl}, Path=AverageReading}" Style="{StaticResource WaTitleLabelStyle}" HorizontalOptions="Center"/>
                <Label Text="{Binding Source={x:Reference DataSummaryControl}, Path=Unit}" Style="{StaticResource WaUnitLabelStyle}" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>

        <Border Grid.Column="1">
            <VerticalStackLayout VerticalOptions="Center" Margin="10">
                <Label Text="{x:Static AppResources.last_entry}" Style="{StaticResource WaUnitLabelStyle}" HorizontalOptions="Center"/>
                <Label Text="{Binding Source={x:Reference DataSummaryControl}, Path=LastReading}" Style="{StaticResource WaTitleLabelStyle}" HorizontalOptions="Center"/>
                <Label Text="{Binding Source={x:Reference DataSummaryControl}, Path=Unit}" Style="{StaticResource WaUnitLabelStyle}" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentView>
