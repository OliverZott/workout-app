<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="workout_app.Pages.ActivityInsertPage"
             x:DataType="ActivityInsertPageModel"
             HideSoftInputOnTapped="True"
             Title="{x:Static AppResources.activity_insert_title}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20">

            <!-- DateTime Picker Control -->
            <DateTimePicker
                SelectedDate="{Binding DateTimePicker.SelectedDate}"
                SelectedTime="{Binding DateTimePicker.SelectedTime}"
                SelectedDateDisplay="{Binding DateTimePicker.SelectedDateDisplay}"
                SelectedTimeDisplay="{Binding DateTimePicker.SelectedTimeDisplay}"/>

            <!-- Activity Type -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static AppResources.activity}" Style="{StaticResource WaSectionLabelStyle}"/>
                    
                    <Border Style="{StaticResource WaCompactInputBorderStyle}"
                            WidthRequest="240">
                        <Picker
                            Style="{StaticResource WaCompactPickerStyle}"
                            Title="{x:Static AppResources.activity_select_title}"
                            ItemsSource="{Binding AvailableActivities}"
                            SelectedItem="{Binding SelectedActivityType}"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Duration -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static AppResources.duration}" Style="{StaticResource WaSectionLabelStyle}"/>

                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="8"
                          HorizontalOptions="Center">

                        <Border Grid.Column="0"
                                Style="{StaticResource WaCompactInputBorderStyle}"
                                WidthRequest="92">
                            <Entry
                                Style="{StaticResource WaCompactNumericEntryStyle}"
                                Text="{Binding SelectedHours, Mode=TwoWay}"
                                FontAttributes="Bold"
                                MaxLength="2"/>
                        </Border>
                        <Label Grid.Column="1" Text="{x:Static AppResources.unit_h}" Style="{StaticResource WaUnitLabelStyle}"/>

                        <Border Grid.Column="2"
                                Style="{StaticResource WaCompactInputBorderStyle}"
                                WidthRequest="92">
                            <Entry
                                Style="{StaticResource WaCompactNumericEntryStyle}"
                                Text="{Binding SelectedMinutes, Mode=TwoWay}"
                                FontAttributes="Bold"
                                MaxLength="2"/>
                        </Border>
                        <Label Grid.Column="3" Text="{x:Static AppResources.unit_min}" Style="{StaticResource WaUnitLabelStyle}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Distance & Altitude -->
            <Border Padding="16" IsVisible="{Binding DistanceEnabled}">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="16" HorizontalOptions="Start">

                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="{x:Static AppResources.distance}" Style="{StaticResource WaSectionLabelStyle}"/>
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" HorizontalOptions="Start">
                            <Border Grid.Column="0"
                                    Style="{StaticResource WaCompactInputBorderStyle}"
                                    WidthRequest="110">
                                <Entry
                                    Style="{StaticResource WaCompactNumericEntryStyle}"
                                    Text="{Binding Distance, Mode=TwoWay}"
                                    HorizontalTextAlignment="End"
                                    Margin="0,0,10,0"
                                    MaxLength="6"/>
                            </Border>
                            <Label Grid.Column="1" Text="{x:Static AppResources.unit_km}" Style="{StaticResource WaUnitLabelStyle}"/>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="{x:Static AppResources.altitude}" Style="{StaticResource WaSectionLabelStyle}"/>
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" HorizontalOptions="Start">
                            <Border Grid.Column="0"
                                    Style="{StaticResource WaCompactInputBorderStyle}"
                                    WidthRequest="110">
                                <Entry
                                    Style="{StaticResource WaCompactNumericEntryStyle}"
                                    Text="{Binding Altitude, Mode=TwoWay}"
                                    HorizontalTextAlignment="End"
                                    Margin="0,0,10,0"
                                    MaxLength="5"/>
                            </Border>
                            <Label Grid.Column="1" Text="{x:Static AppResources.unit_hm}" Style="{StaticResource WaUnitLabelStyle}"/>
                        </Grid>
                    </VerticalStackLayout>

                </Grid>
            </Border>

            <!-- Description -->
            <Border Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static AppResources.description}"
                           Style="{StaticResource WaSectionLabelStyle}"/>

                    <Border Style="{StaticResource WaCompactInputBorderStyle}"
                            WidthRequest="240"
                            HeightRequest="60">
                        <Editor Style="{StaticResource WaCompactEditorStyle}"
                                Text="{Binding Description, Mode=TwoWay}"
                                AutoSize="TextChanges"
                                HeightRequest="60"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Save Button -->
            <BasicButton
                Text="{x:Static AppResources.button_save}"
                Command="{Binding SaveActivityCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
