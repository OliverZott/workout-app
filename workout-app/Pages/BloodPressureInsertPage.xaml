<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="workout_app.Pages.BloodPressureInsertPage"
             x:DataType="BloodPressureInsertPageModel"
             HideSoftInputOnTapped="True"
             Title="{x:Static AppResources.bloodpressure}">

    <VerticalStackLayout Spacing="50" Padding="20">

        <!--  DateTime Picker Control -->
        <DateTimePicker
            SelectedDate="{Binding DateTimePicker.SelectedDate}"
            SelectedTime="{Binding DateTimePicker.SelectedTime}"
            SelectedDateDisplay="{Binding DateTimePicker.SelectedDateDisplay}"
            SelectedTimeDisplay="{Binding DateTimePicker.SelectedTimeDisplay}" />

        <!-- Blood Pressure Input Fields -->
        <Border Padding="24">
            <Grid ColumnDefinitions="2*, *"
                  RowDefinitions="*, *, *"
                  ColumnSpacing="16"
                  RowSpacing="16">

                <Border Style="{StaticResource WaCompactInputBorderStyle}">
                    <Picker Style="{StaticResource WaCompactPickerStyle}"
                            ItemsSource="{Binding BloodPressureValues}"
                            SelectedItem="{Binding SelectedSystolic}"/>
                </Border>
                <Label Grid.Column="1"
                       Text="{x:Static AppResources.bloodpressure_sys_short}"
                       Style="{StaticResource WaUnitLabelStyle}"/>

                <Border Grid.Row="1" Style="{StaticResource WaCompactInputBorderStyle}">
                    <Picker Style="{StaticResource WaCompactPickerStyle}"
                            ItemsSource="{Binding DiastolicValues}"
                            SelectedItem="{Binding SelectedDiastolic}"/>
                </Border>
                <Label Grid.Row="1"
                       Grid.Column="1"
                       Text="{x:Static AppResources.bloodpressure_dia_short}"
                       Style="{StaticResource WaUnitLabelStyle}"/>

                <Border Grid.Row="2" Style="{StaticResource WaCompactInputBorderStyle}">
                    <Picker Style="{StaticResource WaCompactPickerStyle}"
                            ItemsSource="{Binding PulsValues}"
                            SelectedItem="{Binding SelectedPulse}"/>
                </Border>
                <Label Grid.Row="2"
                       Grid.Column="1"
                       Text="{x:Static AppResources.bloodpressure_pulse_short}"
                       Style="{StaticResource WaUnitLabelStyle}"/>

            </Grid>
        </Border>

        <!-- Save Button -->
        <Grid ColumnDefinitions="*, 2*, *">
            <BasicButton
                Grid.Column="1"
                Text="{x:Static AppResources.button_save}"
                Command="{Binding SaveBloodPressureCommand}"/>
        </Grid>

    </VerticalStackLayout>

</ContentPage>
