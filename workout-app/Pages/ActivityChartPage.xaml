<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
             x:Class="workout_app.Pages.ActivityChartPage"
             x:Name="Page"
             x:DataType="ActivityChartPageModel"
             Title="{x:Static AppResources.activity}">

    <CollectionView
        ItemsSource="{Binding VisibleActivities}"
        RemainingItemsThreshold="5"
        RemainingItemsThresholdReachedCommand="{Binding LoadMoreActivitiesCommand}">

        <CollectionView.Header>
            <VerticalStackLayout Padding="20,10" Spacing="10">

                <!-- Time Range Selection -->
                <DateRangeSelector
                    SelectedRange="{Binding SelectedRange}"
                    RangeSelectedCommand="{Binding SelectRangeCommand}"
                    FirstRangeText="{x:Static AppResources.range_week}"
                    SecondRangeText="{x:Static AppResources.range_month}"
                    ThirdRangeText="{x:Static AppResources.range_max}"
                    FirstRangeValue="Week"
                    SecondRangeValue="Month"
                    ThirdRangeValue="Max"/>

                <!-- Summary -->
                <DataSummary
                    AverageReading="{Binding AverageDurationReading}"
                    LastReading="{Binding LastDurationReading}"
                    Unit="min"/>

                <!-- Activity Checkboxes (top 3 most used) -->
                <HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4" IsVisible="{Binding HasActivity1}">
                        <CheckBox IsChecked="{Binding ShowActivity1}" Color="{StaticResource wa-color-activity1}"/>
                        <Label Text="{Binding Activity1Label}" VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4" IsVisible="{Binding HasActivity2}">
                        <CheckBox IsChecked="{Binding ShowActivity2}" Color="{StaticResource wa-color-activity2}"/>
                        <Label Text="{Binding Activity2Label}" VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4" IsVisible="{Binding HasActivity3}">
                        <CheckBox IsChecked="{Binding ShowActivity3}" Color="{StaticResource wa-color-activity3}"/>
                        <Label Text="{Binding Activity3Label}" VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <!-- Chart Element -->
                <Border
                    Padding="30"
                    HeightRequest="360">

                    <sf:SfCartesianChart>

                        <!-- Legend -->
                        <sf:SfCartesianChart.Legend>
                            <sf:ChartLegend Placement="Top"/>
                        </sf:SfCartesianChart.Legend>

                        <!-- Axes -->
                        <sf:SfCartesianChart.XAxes>
                            <sf:CategoryAxis LabelPlacement="BetweenTicks"/>
                        </sf:SfCartesianChart.XAxes>

                        <sf:SfCartesianChart.YAxes>
                            <sf:NumericalAxis
                                Minimum="0"
                                Maximum="{Binding MaxActivityWithPadding}" />
                        </sf:SfCartesianChart.YAxes>

                        <!-- Activity 1 -->
                        <sf:ColumnSeries
                            ItemsSource="{Binding Activity1Data}"
                            XBindingPath="Label"
                            YBindingPath="Value"
                            Fill="{StaticResource wa-color-activity1}"
                            Label="{Binding Activity1Label}"
                            IsVisible="{Binding ShowActivity1}"
                            IsVisibleOnLegend="{Binding ShowActivity1}"/>

                        <!-- Activity 2 -->
                        <sf:ColumnSeries
                            ItemsSource="{Binding Activity2Data}"
                            XBindingPath="Label"
                            YBindingPath="Value"
                            Fill="{StaticResource wa-color-activity2}"
                            Label="{Binding Activity2Label}"
                            IsVisible="{Binding ShowActivity2}"
                            IsVisibleOnLegend="{Binding ShowActivity2}"/>

                        <!-- Activity 3 -->
                        <sf:ColumnSeries
                            ItemsSource="{Binding Activity3Data}"
                            XBindingPath="Label"
                            YBindingPath="Value"
                            Fill="{StaticResource wa-color-activity3}"
                            Label="{Binding Activity3Label}"
                            IsVisible="{Binding ShowActivity3}"
                            IsVisibleOnLegend="{Binding ShowActivity3}"/>

                        <!-- Average line (legend entry) -->
                        <sf:LineSeries
                            Label="{x:Static AppResources.average}"
                            Fill="LightGray"
                            StrokeDashArray="4,4"
                            StrokeWidth="2"
                            IsVisibleOnLegend="True"
                            IsVisible="True"/>

                        <sf:SfCartesianChart.Annotations>
                            <sf:HorizontalLineAnnotation
                                Y1="{Binding AverageDuration}"
                                Stroke="LightGray"
                                StrokeWidth="2"
                                StrokeDashArray="4,4"
                                ShowAxisLabel="False"/>
                        </sf:SfCartesianChart.Annotations>

                    </sf:SfCartesianChart>

                </Border>

                <FunctionButton
                    Text="{x:Static AppResources.button_value_insert}"
                    Command="{Binding GoToInsertActivityCommand}"/>

                <Label Text="{x:Static AppResources.activities}" Style="{StaticResource WaTitleLabelStyle}"/>

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="ActivityData">
                <!-- Wrapper keeps the border shadow from being clipped -->
                <VerticalStackLayout Padding="30,0,30,12">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                <DeleteSwipeItem
                                    Command="{Binding ViewModel.DeleteActivityCommand, Source={x:Reference Page}, x:DataType=ActivityChartPage}"
                                    CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Padding="12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ViewModel.EditActivityCommand, Source={x:Reference Page}, x:DataType=ActivityChartPage}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy}'}"
                                    FontAttributes="Bold" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                    TextColor="{StaticResource Gray500}" />

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Type}"
                                    FontAttributes="Bold" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding DisplayDetails}"
                                    TextColor="{StaticResource Gray500}" />

                                <Label
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Margin="0,8,0,0"
                                    Text="{Binding Description}"
                                    FontAttributes="Italic"
                                    IsVisible="{Binding HasDescription}" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <VerticalStackLayout Padding="0,8,0,32">
                <ActivityIndicator
                    IsRunning="{Binding IsLoadingMore}"
                    IsVisible="{Binding IsLoadingMore}" />
            </VerticalStackLayout>
        </CollectionView.Footer>
    </CollectionView>

</ContentPage>

