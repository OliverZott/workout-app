<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
             x:Class="workout_app.Pages.ActivityChartPage"
             x:DataType="ActivityChartPageModel"
             Title="{x:Static AppResources.activity}">

    <CollectionView
        ItemsSource="{Binding VisibleActivities}"
        RemainingItemsThreshold="5"
        RemainingItemsThresholdReachedCommand="{Binding LoadMoreActivitiesCommand}">

        <CollectionView.Header>
            <VerticalStackLayout Padding="20" Spacing="10">

                <!-- Time Range Selection -->
                <DateRangeSelector
                    Margin="10,0,10,0"
                    SelectedRange="{Binding SelectedRange}"
                    RangeSelectedCommand="{Binding SelectRangeCommand}"
                    FirstRangeText="{x:Static AppResources.range_week}"
                    SecondRangeText="{x:Static AppResources.range_month}"
                    ThirdRangeText="{x:Static AppResources.range_max}"
                    FirstRangeValue="Week"
                    SecondRangeValue="Month"
                    ThirdRangeValue="Max"/>

                <!-- Summary -->
                <DataSummary
                    Margin="10,0,10,0"
                    AverageReading="{Binding AverageDurationReading}"
                    LastReading="{Binding LastDurationReading}"
                    Unit="min"/>

                <!-- Activity Checkboxes (top 3 most used) -->
                <HorizontalStackLayout >
                    <HorizontalStackLayout Spacing="4"
                            IsVisible="{Binding HasActivity1}">
                        <CheckBox IsChecked="{Binding ShowActivity1}"
                                Color="#4CAF50"/>
                        <Label Text="{Binding Activity1Label}"
                                VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4"
                            IsVisible="{Binding HasActivity2}">
                        <CheckBox IsChecked="{Binding ShowActivity2}"
                                Color="#2196F3"/>
                        <Label Text="{Binding Activity2Label}"
                                VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4"
                            IsVisible="{Binding HasActivity3}">
                        <CheckBox IsChecked="{Binding ShowActivity3}"
                                Color="#FF9800"/>
                        <Label Text="{Binding Activity3Label}"
                                VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <!-- Chart Element -->
                <Border
                    Margin="10,0,10,0"
                    Padding="30"
                    HeightRequest="360">

                    <sf:SfCartesianChart>

                        <!-- Legend -->
                        <sf:SfCartesianChart.XAxes>
                            <sf:CategoryAxis LabelPlacement="BetweenTicks"/>
                        </sf:SfCartesianChart.XAxes>

                        <!-- Axes -->
                        <sf:SfCartesianChart.YAxes>
                            <sf:NumericalAxis
                                Minimum="0"
                                Maximum="{Binding MaxActivityWithPadding}" />
                        </sf:SfCartesianChart.YAxes>

                        <sf:SfCartesianChart.Legend>
                            <sf:ChartLegend Placement="Top"/>
                        </sf:SfCartesianChart.Legend>

                        <!-- Activity 1 -->
                        <sf:ColumnSeries
                            ItemsSource="{Binding Activity1Data}"
                            XBindingPath="Label"
                            YBindingPath="Value"
                            Fill="#4CAF50"
                            Label="{Binding Activity1Label}"
                            IsVisible="{Binding ShowActivity1}"/>

                        <!-- Activity 2 -->
                        <sf:ColumnSeries
                            ItemsSource="{Binding Activity2Data}"
                            XBindingPath="Label"
                            YBindingPath="Value"
                            Fill="#2196F3"
                            Label="{Binding Activity2Label}"
                            IsVisible="{Binding ShowActivity2}"/>

                        <!-- Activity 3 -->
                        <sf:ColumnSeries
                            ItemsSource="{Binding Activity3Data}"
                            XBindingPath="Label"
                            YBindingPath="Value"
                            Fill="#FF9800"
                            Label="{Binding Activity3Label}"
                            IsVisible="{Binding ShowActivity3}"/>

                        <!-- Average line (legend entry) -->
                        <sf:LineSeries
                            Label="{x:Static AppResources.average}"
                            Fill="LightGray"
                            StrokeDashArray="4,4"
                            StrokeWidth="2"
                            IsVisibleOnLegend="True"
                            IsVisible="True"/>

                        <sf:SfCartesianChart.Annotations>
                            <sf:HorizontalLineAnnotation
                                Y1="{Binding AverageDuration}"
                                Stroke="LightGray"
                                StrokeWidth="2"
                                StrokeDashArray="4,4"
                                ShowAxisLabel="False"/>
                        </sf:SfCartesianChart.Annotations>

                    </sf:SfCartesianChart>

                </Border>

                <FunctionButton
                    Text="{x:Static AppResources.button_value_insert}"
                    Command="{Binding GoToInsertActivityCommand}"/>

                <Label
                    Margin="10,0,10,0"
                    Text="{x:Static AppResources.activities}"
                    FontAttributes="Bold"
                    FontSize="18" />

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="ActivityData">
                <!-- Wrapper keeps the border shadow from being clipped -->
                <VerticalStackLayout Padding="30,0,30,12">
                    <Border Padding="12">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy}'}"
                                FontAttributes="Bold" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                TextColor="Gray" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding Type}"
                                FontAttributes="Bold" />
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding DisplayDetails}"
                                TextColor="Gray" />

                            <Label
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,8,0,0"
                                Text="{Binding Description}"
                                FontAttributes="Italic"
                                IsVisible="{Binding HasDescription}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <VerticalStackLayout Padding="0,8,0,32">
                <ActivityIndicator
                    IsRunning="{Binding IsLoadingMore}"
                    IsVisible="{Binding IsLoadingMore}" />
            </VerticalStackLayout>
        </CollectionView.Footer>
    </CollectionView>

</ContentPage>

