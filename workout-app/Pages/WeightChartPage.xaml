<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
             x:Class="workout_app.Pages.WeightChartPage"
             x:DataType="WeightChartPageModel"
             Title="{x:Static AppResources.weight}">

    <CollectionView
        ItemsSource="{Binding VisibleMeasurements}"
        RemainingItemsThreshold="5"
        RemainingItemsThresholdReachedCommand="{Binding LoadMoreMeasurementsCommand}">

        <CollectionView.Header>
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Time Range Selection -->
                <DateRangeSelector 
                    Margin="10,0,10,0"
                    SelectedRange="{Binding SelectedRange}"
                    RangeSelectedCommand="{Binding SelectRangeCommand}"
                    FirstRangeText="{x:Static AppResources.range_week}" 
                    SecondRangeText="{x:Static AppResources.range_month}" 
                    ThirdRangeText="{x:Static AppResources.range_max}"
                    FirstRangeValue="Week"
                    SecondRangeValue="Month" 
                    ThirdRangeValue="Max" />

                <!-- Summary Element -->
                <DataSummary
                    Margin="10,0,10,0"
                    AverageReading="{Binding AverageWeightReading}"
                    LastReading="{Binding LastWeightReading}"
                    Unit="kg" />

                <!-- Chart Element -->
                <Border
                    Margin="10,0,10,0"
                    Padding="30"
                    HeightRequest="400">

                    <sf:SfCartesianChart>

                        <!-- Legend -->
                        <sf:SfCartesianChart.Legend>
                            <sf:ChartLegend Placement="Top"/>
                        </sf:SfCartesianChart.Legend>

                        <!-- Axes -->
                        <sf:SfCartesianChart.XAxes>
                            <sf:CategoryAxis LabelPlacement="BetweenTicks" />
                        </sf:SfCartesianChart.XAxes>

                        <sf:SfCartesianChart.YAxes>
                            <sf:NumericalAxis 
                            Minimum="{Binding MinWeightWithPadding}"
                            Maximum="{Binding MaxWeightWithPadding}" />
                        </sf:SfCartesianChart.YAxes>

                        <sf:LineSeries 
                            ItemsSource="{Binding Data}"
                            XBindingPath="DisplayDate"
                            YBindingPath="Weight"
                            Fill="Grey"
                            Label="{x:Static AppResources.weight}" 
                            ShowDataLabels="False"
                            IsVisibleOnLegend="False"
                            ShowMarkers="True"/>
                        <sf:LineSeries 
                            Label="{x:Static AppResources.average}"
                            Fill="LightGray"               
                            StrokeDashArray="4,4"
                            StrokeWidth="2"
                            IsVisibleOnLegend="True"
                            IsVisible="True" />


                        <!-- ⭐ Fixed horizontal dotted line -->
                        <sf:SfCartesianChart.Annotations>
                            <sf:HorizontalLineAnnotation 
                                Y1="{Binding AverageWeightReading}"                     
                                Stroke="LightGray"
                                StrokeWidth="2"
                                StrokeDashArray="4,4"
                                ShowAxisLabel="False" />
                        </sf:SfCartesianChart.Annotations>

                    </sf:SfCartesianChart>

                </Border>

                <FunctionButton
                    Text="{x:Static AppResources.button_value_insert}"
                    Margin="10,0,10,0"
                    Command="{Binding GoToInsertWeightCommand}"/>

                <Label
                    Margin="10,0,10,0"
                    Text="{x:Static AppResources.measurements}"
                    FontAttributes="Bold"
                    FontSize="18" />

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="WeightData">
                <!-- Wrapper keeps the border shadow from being clipped -->
                <VerticalStackLayout Padding="30,0,30,12">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                <SwipeItemView
                                    Command="{Binding DeleteMeasurementCommand, Source={RelativeSource AncestorType={x:Type WeightChartPageModel}}, x:DataType=WeightChartPageModel}"
                                    CommandParameter="{Binding .}">
                                    <Border
                                        Margin="8,0,0,0"
                                        WidthRequest="90"
                                        BackgroundColor="{StaticResource wa-color-delete}"
                                        Stroke="{StaticResource wa-color-delete}">
                                        <Label
                                            Text="{x:Static AppResources.button_delete}"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Padding="12">
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy}'}"
                                    FontAttributes="Bold" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                    TextColor="Gray" />

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Weight, StringFormat='{}{0:0.0} kg'}"
                                    FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <VerticalStackLayout Padding="0,8,0,32">
                <ActivityIndicator
                    IsRunning="{Binding IsLoadingMore}"
                    IsVisible="{Binding IsLoadingMore}" />
            </VerticalStackLayout>
        </CollectionView.Footer>
    </CollectionView>

</ContentPage>