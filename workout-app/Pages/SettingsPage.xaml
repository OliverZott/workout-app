<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="workout_app.Pages.SettingsPage"
    x:DataType="SettingsPageModel"
    Title="{x:Static AppResources.settings}">

    <ContentPage.Resources>
        <Style x:Key="SectionHeader" TargetType="Label" BasedOn="{StaticResource WaSectionLabelStyle}">
            <Setter Property="TextTransform" Value="Uppercase"/>
            <Setter Property="Margin" Value="4,12,0,0"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="Label" CanCascade="True">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
        <Style x:Key="RowHint" TargetType="Label" BasedOn="{StaticResource WaDescriptionLabelStyle}">
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <!-- Reminders -->
            <Label Text="{x:Static AppResources.settings_notifications}" Style="{StaticResource SectionHeader}"/>
            <Border Padding="16,8">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <Label Text="{x:Static AppResources.settings_workout_reminder}" Style="{StaticResource RowTitle}"/>
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding IsNotificationEnabled, Mode=TwoWay}"
                            Toggled="OnNotificationSwitchToggled"/>
                        <HorizontalStackLayout Grid.Row="1" Spacing="4">
                            <Label Text="{x:Static AppResources.settings_daily_at}" Style="{StaticResource RowHint}"/>
                            <TimePicker
                                Format="HH:mm"
                                FontSize="13"
                                Time="{Binding NotificationTime}"
                                IsEnabled="{Binding IsNotificationEnabled}"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                        <Label Text="{x:Static AppResources.medication}" Style="{StaticResource RowTitle}"/>
                        <Switch Grid.Column="1" IsToggled="{Binding IsMedicationReminderEnabled, Mode=TwoWay}"/>
                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="Auto, Auto"
                            RowDefinitions="Auto, Auto, Auto, Auto"
                            ColumnSpacing="16"
                            Margin="0,4,0,0">
                            <Label Text="{x:Static AppResources.medication_slot_morning}" Style="{StaticResource RowHint}"/>
                            <Label Grid.Column="1" Text="08:00" Style="{StaticResource RowHint}"/>
                            <Label Grid.Row="1" Text="{x:Static AppResources.medication_slot_noon}" Style="{StaticResource RowHint}"/>
                            <Label Grid.Row="1" Grid.Column="1" Text="12:00" Style="{StaticResource RowHint}"/>
                            <Label Grid.Row="2" Text="{x:Static AppResources.medication_slot_evening}" Style="{StaticResource RowHint}"/>
                            <Label Grid.Row="2" Grid.Column="1" Text="18:00" Style="{StaticResource RowHint}"/>
                            <Label Grid.Row="3" Text="{x:Static AppResources.medication_slot_night}" Style="{StaticResource RowHint}"/>
                            <Label Grid.Row="3" Grid.Column="1" Text="20:00" Style="{StaticResource RowHint}"/>
                        </Grid>
                        <Label
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Text="{x:Static AppResources.settings_medication_reminders_description}"
                            Style="{StaticResource RowHint}"
                            Margin="0,4,0,8"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Export Data -->
            <Label Text="{x:Static AppResources.settings_export_data}" Style="{StaticResource SectionHeader}"/>
            <Border Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{x:Static AppResources.settings_export_description}" Style="{StaticResource RowHint}"/>
                    <BasicButton Text="{x:Static AppResources.settings_export_csv}" Command="{Binding ExportDataToCsvCommand}"/>
                    <BasicButton Text="{x:Static AppResources.settings_export_db}" Command="{Binding ExportDatabaseBackupCommand}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Import Data -->
            <Label Text="{x:Static AppResources.settings_import_data}" Style="{StaticResource SectionHeader}"/>
            <Border Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{x:Static AppResources.settings_import_description}" Style="{StaticResource RowHint}"/>
                    <BasicButton Text="{x:Static AppResources.settings_import_db}" Command="{Binding ImportDatabaseBackupCommand}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Logging -->
            <Label Text="{x:Static AppResources.settings_section_logging}" Style="{StaticResource SectionHeader}"/>
            <Border Padding="16,8,16,16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="{x:Static AppResources.settings_enable_logging}" Style="{StaticResource RowTitle}"/>
                        <Switch Grid.Column="1" IsToggled="{Binding IsLoggingEnabled, Mode=TwoWay}"/>
                    </Grid>
                    <Label Text="{x:Static AppResources.settings_logging_description}" Style="{StaticResource RowHint}"/>
                    <BasicButton Text="{x:Static AppResources.settings_send_logs}" Command="{Binding SendLogsCommand}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Result of export / import / send logs -->
            <Label Text="{Binding StatusMessage}" Style="{StaticResource RowHint}" Margin="4,0"/>

            <!-- Info -->
            <Label Text="{x:Static AppResources.settings_section_info}" Style="{StaticResource SectionHeader}"/>
            <Border Padding="16">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="{x:Static AppResources.settings_app_version}" Style="{StaticResource RowHint}" FontSize="16"/>
                    <Label Grid.Column="1" Text="{Binding AppVersion}" FontSize="16"/>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
