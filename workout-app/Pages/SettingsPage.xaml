<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="workout_app.Pages.SettingsPage"
    x:DataType="SettingsPageModel"
    Title="{x:Static AppResources.settings}">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="30">

            <!-- Notifications -->
            <VerticalStackLayout Spacing="8">
                <Label Text="{x:Static AppResources.settings_notifications}" Style="{StaticResource WaTitleLabelStyle}"/>
                <Grid ColumnDefinitions="*, Auto">
                    <TimePicker
                        Time="{Binding NotificationTime}"
                        HorizontalOptions="Start"
                        FontSize="20"
                        TextColor="Black"/>
                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding IsNotificationEnabled, Mode=TwoWay}"
                        Toggled="OnNotificationSwitchToggled"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Export Data -->
            <VerticalStackLayout Spacing="8">
                <Label Text="{x:Static AppResources.settings_export_data}" Style="{StaticResource WaTitleLabelStyle}"/>
                <Label Text="{x:Static AppResources.settings_export_description}" Style="{StaticResource WaDescriptionLabelStyle}"/>
                <BasicButton Text="{x:Static AppResources.settings_export_csv}" Command="{Binding ExportDataToCsvCommand}"/>
                <BasicButton Text="{x:Static AppResources.settings_export_db}" Command="{Binding ExportDatabaseBackupCommand}"/>
            </VerticalStackLayout>

            <!-- Import Data -->
            <VerticalStackLayout Spacing="8">
                <Label Text="{x:Static AppResources.settings_import_data}" Style="{StaticResource WaTitleLabelStyle}"/>
                <Label Text="{x:Static AppResources.settings_import_description}" Style="{StaticResource WaDescriptionLabelStyle}"/>
                <BasicButton Text="{x:Static AppResources.settings_import_db}" Command="{Binding ImportDatabaseBackupCommand}"/>
            </VerticalStackLayout>

            <!-- Logging -->
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*, Auto">
                    <Label
                        Text="{x:Static AppResources.settings_enable_logging}"
                        Style="{StaticResource WaTitleLabelStyle}"
                        VerticalOptions="Center"/>
                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding IsLoggingEnabled, Mode=TwoWay}"/>
                </Grid>
                <Label Text="{x:Static AppResources.settings_logging_description}" Style="{StaticResource WaDescriptionLabelStyle}"/>
                <BasicButton Text="{x:Static AppResources.settings_send_logs}" Command="{Binding SendLogsCommand}"/>
                <Label Text="{Binding StatusMessage}" Style="{StaticResource WaDescriptionLabelStyle}"/>
            </VerticalStackLayout>

            <!-- App Version -->
            <HorizontalStackLayout>
                <Label Text="{x:Static AppResources.settings_app_version}" FontAttributes="Bold"/>
                <Label Text="{Binding AppVersion}"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
