<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/maui/global"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="workout_app.Pages.MainPage"
    Title="{x:Static AppResources.app_title}">

    <ScrollView>
        <Grid
            ColumnDefinitions="*, *"
            RowDefinitions="Auto, Auto"
            Margin="20"
            RowSpacing="30"
            ColumnSpacing="10">

            <MainTile
                TileText="{x:Static AppResources.bloodpressure}"
                ImageSource="bloodpressure"
                TapCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToCardioCommand}"/>

            <MainTile
                Grid.Column="1"
                TileText="{x:Static AppResources.weight}"
                ImageSource="weight"
                TapCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToWeightCommand}"/>

            <MainTile
                Grid.Row="1"
                TileText="{x:Static AppResources.activity}"
                ImageSource="activity"
                TapCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToActivityCommand}"/>

            <MainTile
                Grid.Row="1"
                Grid.Column="1"
                TileText="{x:Static AppResources.motion_sensors}"
                ImageSource="motion"
                TapCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToMotionSensorsCommand}"/>

        </Grid>
    </ScrollView>

</ContentPage>
