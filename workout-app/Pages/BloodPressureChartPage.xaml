<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
             x:Class="workout_app.Pages.BloodPressureChartPage"
             x:Name="Page"
             x:DataType="BloodPressureChartPageModel"
             Title="{x:Static AppResources.bloodpressure}">

    <CollectionView
        ItemsSource="{Binding VisibleMeasurements}"
        RemainingItemsThreshold="5"
        RemainingItemsThresholdReachedCommand="{Binding LoadMoreMeasurementsCommand}">

        <CollectionView.Header>
            <VerticalStackLayout Padding="20,10" Spacing="10">

                <!-- Time Range Selection -->
                <DateRangeSelector 
                    SelectedRange="{Binding SelectedRange}"
                    RangeSelectedCommand="{Binding SelectRangeCommand}"
                    FirstRangeText="{x:Static AppResources.range_week}" 
                    SecondRangeText="{x:Static AppResources.range_month}" 
                    ThirdRangeText="{x:Static AppResources.range_max}"
                    FirstRangeValue="Week"
                    SecondRangeValue="Month" 
                    ThirdRangeValue="Max" />

                <!-- Summary Element -->
                <DataSummary
                    AverageReading="{Binding AverageBloodPressureReading}"
                    LastReading="{Binding LastBloodPressureReading}"
                    Unit="mmHg" />

                <!-- Chart Element -->
                <Border
                    Padding="30"
                    HeightRequest="400">

                    <sf:SfCartesianChart>

                        <!-- Legend -->
                        <sf:SfCartesianChart.Legend>
                            <sf:ChartLegend Placement="Top"/>
                        </sf:SfCartesianChart.Legend>

                        <!-- Axes -->
                        <sf:SfCartesianChart.XAxes>
                            <sf:CategoryAxis LabelPlacement="BetweenTicks" />
                        </sf:SfCartesianChart.XAxes>

                        <sf:SfCartesianChart.YAxes>
                            <sf:NumericalAxis
                                Minimum="{Binding MinBloodPressureWithPadding}"
                                Maximum="{Binding MaxBloodPressureWithPadding}" />
                        </sf:SfCartesianChart.YAxes>

                        <sf:LineSeries 
                            ItemsSource="{Binding Data}"
                            XBindingPath="DisplayDate"
                            YBindingPath="Systolic"
                            Fill="{StaticResource wa-color-systolic}"
                            Label="{x:Static AppResources.systolic}" 
                            ShowDataLabels="False"
                            ShowMarkers="True"/>

                        <sf:LineSeries 
                            ItemsSource="{Binding Data}"
                            XBindingPath="DisplayDate"
                            YBindingPath="Diastolic"
                            Fill="{StaticResource wa-color-diastolic}"
                            Label="{x:Static AppResources.diastolic}"
                            ShowMarkers="True"/>

                        <sf:LineSeries 
                            ItemsSource="{Binding Data}"
                            XBindingPath="DisplayDate"
                            YBindingPath="HeartRate"
                            Fill="{StaticResource wa-color-heartrate}"
                            Label="{x:Static AppResources.heartrate}" 
                            ShowMarkers="True"/>
                    </sf:SfCartesianChart>
                </Border>

                <BasicButton
                    Text="{x:Static AppResources.button_value_insert}"
                    Command="{Binding GoToInsertCardioCommand}"/>

                <Label Text="{x:Static AppResources.measurements}" Style="{StaticResource WaTitleLabelStyle}"/>

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="BloodPressureData">
                <!-- Wrapper keeps the border shadow from being clipped -->
                <VerticalStackLayout Padding="20,0,20,12">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                <DeleteSwipeItem
                                    Command="{Binding ViewModel.DeleteMeasurementCommand, Source={x:Reference Page}, x:DataType=BloodPressureChartPage}"
                                    CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Padding="12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ViewModel.EditMeasurementCommand, Source={x:Reference Page}, x:DataType=BloodPressureChartPage}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy}'}"
                                    FontAttributes="Bold" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                    TextColor="{StaticResource Gray500}" />

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Systolic}" />
                                            <Span Text="/" />
                                            <Span Text="{Binding Diastolic}" />
                                            <Span Text=" mmHg" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    TextColor="{StaticResource Gray500}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static AppResources.heartrate}" />
                                            <Span Text=": " />
                                            <Span Text="{Binding HeartRate}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                        </Border>
                    </SwipeView>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <VerticalStackLayout Padding="0,8,0,32">
                <ActivityIndicator
                    IsRunning="{Binding IsLoadingMore}"
                    IsVisible="{Binding IsLoadingMore}" />
            </VerticalStackLayout>
        </CollectionView.Footer>
    </CollectionView>
    
</ContentPage>